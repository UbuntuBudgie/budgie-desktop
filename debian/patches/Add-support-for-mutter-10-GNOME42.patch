diff --git a/src/wm/main.vala b/src/wm/main.vala
index 86e3f2ab..31fa04be 100644
--- a/src/wm/main.vala
+++ b/src/wm/main.vala
@@ -11,7 +11,6 @@
 
 
 public static int main(string[] args) {
-#if HAVE_MUTTER_9
 	Budgie.BudgieWM.old_args = args;
 
 	Meta.Context ctx = Meta.create_context("Mutter(Budgie)");
@@ -40,33 +39,4 @@ public static int main(string[] args) {
 		message("Error running WM: %s", e.message);
 	}
 	return Meta.ExitCode.SUCCESS;
-#else
-	unowned OptionContext? ctx = null;
-	Budgie.BudgieWM.old_args = args;
-
-	ctx = Meta.get_option_context();
-
-	try {
-		if (!ctx.parse(ref args)) {
-			return Meta.ExitCode.ERROR;
-		}
-	} catch (OptionError e) {
-		message("Unknown option: %s", e.message);
-		return Meta.ExitCode.ERROR;
-	}
-
-	/* Set plugin type here */
-	Meta.Plugin.manager_set_plugin_type(typeof(Budgie.BudgieWM));
-	Meta.set_gnome_wm_keybindings("Mutter,GNOME Shell");
-	Meta.set_wm_name("Mutter(Budgie)");
-
-	Environment.set_variable("NO_GAIL", "1", true);
-	Environment.set_variable("NO_AT_BRIDGE", "1", true);
-
-	Meta.init();
-
-	Meta.register_with_session();
-
-	return Meta.run();
-#endif
 }
diff --git a/src/wm/meson.build b/src/wm/meson.build
index 2ca11d83..52c06959 100644
--- a/src/wm/meson.build
+++ b/src/wm/meson.build
@@ -18,18 +18,16 @@ budgie_wm_sources = [
 budgie_wm_status_vala_args = []
 
 dep_graphene = dependency('graphene-gobject-1.0', version: '>= 1.10')
-dep_mutter = dependency('libmutter-9', version: gnome_minimum_version, required: false)
+dep_mutter = dependency('libmutter-10', version: gnome_minimum_version, required: false)
 if dep_mutter.found()
-    budgie_wm_status_vala_args += ['-D', 'HAVE_MUTTER_9']
-    message('Using libmutter-9 ABI from GNOME 41')
-    vapi_mutter = 'libmutter-9'
+    #budgie_wm_status_vala_args += ['-D', 'HAVE_MUTTER_9']
+    message('Using libmutter-10 ABI from GNOME 42')
+    vapi_mutter = 'libmutter-10'
 else
-    dep_mutter = dependency('libmutter-8', version: gnome_minimum_version)
+    dep_mutter = dependency('libmutter-9', version: gnome_minimum_version)
     if dep_mutter.found()
-        # Assume mutter-7 compilation argument since no additional code changes required
-        budgie_wm_status_vala_args += ['-D', 'HAVE_MUTTER_8']
-        message('Using libmutter-8 ABI from GNOME 40')
-        vapi_mutter = 'libmutter-8'
+        message('Using libmutter-9 ABI from GNOME 41')
+        vapi_mutter = 'libmutter-9'
     endif
 endif
 
